---
import Layout from '../layouts/Layout.astro';
import { DemoGraph } from '../components/DemoGraph';

const baseUrl = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const workflow = [
  {
    step: '01',
    title: 'Import a real document',
    body: 'Start with a PDF, DOCX, or DOC file. HyprDuck keeps the primary flow file-first, without screen recording or accessibility permission friction.',
    tag: 'pdf / docx / doc',
  },
  {
    step: '02',
    title: 'Render pages into evidence',
    body: 'Each page becomes an inspectable image snapshot before AI processing, so the markdown can keep a visible link back to the source page.',
    tag: 'page images',
  },
  {
    step: '03',
    title: 'Run the selected provider',
    body: 'Use local mode or a hosted provider depending on your privacy, speed, and cost needs. Provider settings stay shared across parsing flows.',
    tag: 'local / openai / anthropic',
  },
  {
    step: '04',
    title: 'Save agent-ready markdown',
    body: 'HyprDuck writes markdown and linked image assets under Application Support, ready for agents, wikis, notes, and local knowledge workflows.',
    tag: '~/Library/Application Support/HyprDuck',
  },
];

const capabilities = [
  ['Local by default', 'Document import and page rendering happen in the desktop app before any provider call.'],
  ['Provider flexible', 'OpenRouter, OpenAI, Anthropic, and local providers can share the same parsing workflow.'],
  ['Evidence-linked output', 'Generated markdown references the page images on disk instead of hiding the source.'],
];

const providers = [
  {
    name: 'Ollama',
    mode: 'Local',
    description: 'Run private document parsing against local models without an API key.',
    icon: 'provider-icons/ollama.webp',
  },
  {
    name: 'OpenRouter',
    mode: 'Router',
    description: 'Use one provider setting to reach multiple hosted model families.',
    icon: 'provider-icons/openrouter.webp',
  },
  {
    name: 'OpenAI',
    mode: 'Hosted',
    description: 'Parse dense business documents with hosted frontier models.',
    icon: 'provider-icons/openai.webp',
  },
  {
    name: 'Anthropic',
    mode: 'Hosted',
    description: 'Use Claude for long-form document structure and careful extraction.',
    icon: 'provider-icons/anthropic.webp',
    comingSoon: true,
  },
];
---

<Layout>
  <div class="page-shell">
    <header class="site-nav">
      <div class="container nav-inner">
        <a href="#" class="brand" aria-label="HyprDuck home">
          <img src={assetPath('favicon.svg')} alt="" class="brand-mark" />
          <span>HyprDuck</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#workflow">Workflow</a>
          <a href="#providers">Providers</a>
          <a href="#output">Output</a>
        </nav>
        <a class="pill pill-primary nav-cta" href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">
          <img src={assetPath('github.webp')} alt="" class="github-icon" />
          View GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="reading-container hero-copy">
          <div class="status-line">
            <span class="status-dot"></span>
            Local document parsing for agent-ready knowledge.
          </div>
          <h1>Turn documents into agent-ready markdown.</h1>
          <p>
            HyprDuck imports PDFs and Word files, renders every page into images, runs your chosen AI provider, and saves linked markdown that stays inspectable on your machine.
          </p>
          <div class="hero-actions">
            <a class="pill pill-primary" href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">Download desktop</a>
            <a class="pill pill-secondary" href="#workflow">See workflow</a>
          </div>
          <div class="hero-meta" aria-label="Product metadata">
            <span class="tag-pill">macOS</span>
            <span class="tag-pill">local first</span>
            <span class="tag-pill">PDF / DOCX / DOC</span>
          </div>
        </div>

        <div class="container hero-product">
          <div class="desktop-frame hairline-card" aria-label="HyprDuck desktop preview">
            <div class="macos-drag-region"></div>
            <div class="chrome-buttons">
              <span class="chrome-btn" aria-label="Toggle sidebar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
              </span>
              <span class="chrome-btn chrome-bell" aria-label="Brain health">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
                <span class="bell-badge">2</span>
              </span>
              <span class="chrome-btn chrome-btn-active" aria-label="Toggle inspector">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/></svg>
              </span>
            </div>
            <aside class="desktop-sidebar">
              <div class="sidebar-spacer"></div>
              <div class="sidebar-item active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                <span>Knowledge</span>
              </div>
              <div class="sidebar-bottom">
                <div class="sidebar-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Settings</span>
                </div>
              </div>
            </aside>
            <div class="desktop-main">
              <div class="graph-column">
                <DemoGraph client:load selected={{ kind: "node", id: "concept-revenue" }} onSelect={() => {}} />
                <form class="graph-composer">
                  <button class="composer-attach" type="button" aria-label="Attach files">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  </button>
                  <input class="composer-input" placeholder="Ask this knowledge graph..." value="" />
                  <select class="composer-select">
                    <option>Ask only</option>
                    <option>Add to brain</option>
                  </select>
                  <button class="composer-send" type="submit" aria-label="Ask" disabled>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
                  </button>
                </form>
              </div>
              <aside class="inspector-rail">
                <div class="inspector-header">
                  <h3 class="inspector-heading">Right inspector</h3>
                  <p class="inspector-desc">Selection detail, source provenance, and evidence stay visible without leaving the graph.</p>
                </div>
                <div class="inspector-body">
                  <div class="inspector-section">
                    <div class="inspector-tags">
                      <span class="inspector-tag">concept</span>
                      <span class="inspector-tag">72% draft confidence</span>
                    </div>
                    <h4 class="inspector-node-name">Q3 Revenue</h4>
                    <p class="inspector-node-desc">Board report revenue figures for Q3 extracted from financial summary table on page 3.</p>
                    <div class="inspector-aliases">
                      <span class="inspector-alias">Latest import</span>
                      <span class="inspector-alias">Q3 performance</span>
                    </div>
                  </div>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">workflow</span>
          <h2>Import first. Evidence always visible.</h2>
          <p>HyprDuck keeps the landing page and product surface centered on the same path: file in, page evidence, provider run, linked markdown out.</p>
        </div>
        <div class="container workflow-grid">
          {workflow.map((item) => (
            <article class="workflow-card hairline-card">
              <div class="workflow-step">{item.step}</div>
              <span class="tag-pill">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="providers" class="provider-section">
        <div class="container provider-grid">
          <div class="provider-copy">
            <span class="tag-pill">providers</span>
            <h2>Use local mode or bring your preferred AI provider.</h2>
            <p>
              HyprDuck treats AI settings as shared parsing infrastructure. Local operation stays visible, while hosted providers remain available when they fit the job.
            </p>
          </div>
          <div class="provider-card">
            <div class="provider-row">
              <span class="status-dot"></span>
              <span>Local Mode ready</span>
            </div>
            <div class="provider-list" aria-label="Supported AI providers">
              {providers.map((provider) => (
                <article class="provider-item">
                  <div class="provider-icon-wrap">
                    <img
                      src={assetPath(provider.icon)}
                      alt={`${provider.name} logo`}
                      class="provider-icon"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="provider-info">
                    <div class="provider-title-row">
                      <h3>{provider.name}</h3>
                      <div class="provider-badges">
                        <span>{provider.mode}</span>
                        {provider.comingSoon && <span class="coming-soon">Coming soon</span>}
                      </div>
                    </div>
                    <p>{provider.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="output" class="output-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">output</span>
          <h2>Markdown that agents can inspect.</h2>
          <p>Every result should be movable, readable, and grounded in source artifacts on disk.</p>
        </div>
        <div class="container capability-grid">
          {capabilities.map(([title, body]) => (
            <article class="capability-card">
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>HyprDuck</span>
        <div class="footer-links">
          <a href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">GitHub</a>
          <a href="#workflow">Workflow</a>
          <a href="#output">Output</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--color-charcoal);
    font-size: 14px;
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-cta {
    flex: 0 0 auto;
  }

  .github-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .hero {
    padding: 88px 0 72px;
  }

  .hero-copy {
    text-align: center;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    color: var(--color-charcoal);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-terminal-green);
  }

  .hero h1 {
    margin: 28px auto 0;
    max-width: 720px;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 1.02;
    overflow-wrap: break-word;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px;
    line-height: 1.56;
  }

  .hero-actions,
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-product {
    margin-top: 56px;
  }

  .desktop-frame {
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    min-height: 520px;
    overflow: hidden;
    position: relative;
  }

  .macos-drag-region {
    position: absolute;
    inset: 0;
    height: 32px;
    z-index: 1;
    pointer-events: none;
  }

  .chrome-buttons {
    position: absolute;
    top: 8px;
    left: 80px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .chrome-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-body);
    pointer-events: auto;
  }

  .chrome-btn-active {
    background: var(--color-ink);
    color: var(--color-canvas);
  }

  .chrome-bell {
    margin-left: auto;
    position: relative;
  }

  .bell-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    display: grid;
    place-items: center;
    min-width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-terminal-green);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    padding: 0 3px;
  }

  .desktop-sidebar {
    border-right: 1px solid var(--color-hairline);
    background: var(--color-surface-soft);
    padding: 0 10px 12px;
    display: flex;
    flex-direction: column;
  }

  .sidebar-spacer {
    height: 42px;
    flex-shrink: 0;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    color: var(--color-body);
    font-size: 13px;
    font-weight: 500;
  }

  .sidebar-item + .sidebar-item {
    margin-top: 2px;
  }

  .sidebar-item.active {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .sidebar-bottom {
    margin-top: auto;
    padding-bottom: 6px;
    padding-top: 8px;
  }

  .desktop-main {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(200px, 26vw, 260px);
    background: var(--color-canvas);
  }

  .graph-column {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    background: #fff;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    overflow: hidden;
  }

  .graph-composer {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(420px, calc(100% - 40px));
    height: 48px;
    padding: 0 8px 0 4px;
    border: 1px solid var(--color-hairline);
    border-radius: 28px;
    background: var(--color-canvas);
    box-shadow: 0 8px 32px rgba(15, 23, 42, 0.1);
    backdrop-filter: blur(8px);
  }

  .composer-attach {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
    color: var(--color-body);
    flex-shrink: 0;
    cursor: default;
  }

  .composer-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0 4px;
    font-size: 14px;
    color: var(--color-ink);
    outline: none;
    font-family: inherit;
  }

  .composer-input::placeholder {
    color: var(--color-mute);
  }

  .composer-select {
    height: 32px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
    padding: 0 8px;
    font-size: 11px;
    font-weight: 500;
    color: var(--color-ink);
    outline: none;
    cursor: default;
    flex-shrink: 0;
  }

  .composer-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-canvas);
    flex-shrink: 0;
    cursor: default;
  }

  .composer-send:disabled {
    opacity: 0.35;
  }

  .inspector-rail {
    border-left: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .inspector-header {
    border-bottom: 1px solid var(--color-hairline);
    padding: 42px 16px 14px;
  }

  .inspector-heading {
    font-size: 13px;
    font-weight: 600;
  }

  .inspector-desc {
    margin-top: 4px;
    font-size: 11px;
    line-height: 1.45;
    color: var(--color-body);
  }

  .inspector-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .inspector-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .inspector-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .inspector-tag {
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    padding: 3px 10px;
    font-size: 11px;
    background: var(--color-surface-soft);
  }

  .inspector-node-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .inspector-node-desc {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-body);
  }

  .inspector-aliases {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .inspector-alias {
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    padding: 3px 10px;
    font-size: 11px;
    color: var(--color-body);
  }

  .workflow-section,
  .provider-section,
  .output-section {
    padding: 88px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .section-heading {
    text-align: center;
  }

  .section-heading h2,
  .provider-copy h2 {
    margin-top: 18px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .section-heading p,
  .provider-copy p {
    margin-top: 16px;
    font-size: 16px;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .workflow-card {
    padding: 24px;
  }

  .workflow-step {
    margin-bottom: 28px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .workflow-card h3 {
    margin-top: 18px;
    font-size: 20px;
    line-height: 1.35;
  }

  .workflow-card p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.55;
  }

  .provider-section {
    background: var(--color-surface-dark);
    color: var(--color-on-dark);
  }

  .provider-section h2 {
    color: var(--color-on-dark);
  }

  .provider-section p {
    color: var(--color-on-dark-mute);
  }

  .provider-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    align-items: center;
    gap: 48px;
  }

  .provider-card {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    padding: 16px;
    background: rgba(255, 255, 255, 0.04);
  }

  .provider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-on-dark);
    font-weight: 500;
    padding: 8px 8px 16px;
  }

  .provider-list {
    display: grid;
    gap: 10px;
  }

  .provider-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    min-height: 82px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  .provider-icon-wrap {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: var(--color-on-dark);
