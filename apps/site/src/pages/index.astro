---
import Layout from '../layouts/Layout.astro';
import { DemoGraph } from '../components/DemoGraph';

const baseUrl = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const workflow = [
  {
    step: '01',
    title: 'Import a real document',
    body: 'Start with a PDF, DOCX, or DOC file. Etyma keeps the primary flow file-first, without screen recording or accessibility permission friction.',
    tag: 'pdf / docx / doc',
  },
  {
    step: '02',
    title: 'Render pages into evidence',
    body: 'Each page becomes an inspectable image snapshot before AI processing, so the markdown can keep a visible link back to the source page.',
    tag: 'page images',
  },
  {
    step: '03',
    title: 'Run the selected provider',
    body: 'Use local mode or a hosted provider depending on your privacy, speed, and cost needs. Provider settings stay shared across parsing flows.',
    tag: 'local / openrouter',
  },
  {
    step: '04',
    title: 'Save agent-ready markdown',
    body: 'Etyma writes markdown and linked image assets under Application Support, ready for agents, wikis, notes, and local knowledge workflows.',
    tag: '~/Library/Application Support/Etyma',
  },
];

const capabilities = [
  ['Local by default', 'Document import and page rendering happen in the desktop app before any provider call.'],
  ['Provider flexible', 'OpenRouter hosted models and local Ollama models share the same parsing workflow.'],
  ['Evidence-linked output', 'Generated markdown references the page images on disk instead of hiding the source.'],
];

const providers = [
  {
    name: 'Ollama',
    mode: 'Local',
    description: 'Run private document parsing against local models without an API key.',
    icon: 'provider-icons/ollama.webp',
  },
  {
    name: 'OpenRouter',
    mode: 'Router',
    description: 'Use one provider setting to reach multiple hosted model families.',
    icon: 'provider-icons/openrouter.webp',
  },
];
---

<Layout>
  <div class="page-shell">
    <header class="site-nav">
      <div class="container nav-inner">
        <a href="#" class="brand" aria-label="Etyma home">
          <img src={assetPath('favicon.svg')} alt="" class="brand-mark" />
          <span>Etyma</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#workflow">Workflow</a>
          <a href="#providers">Providers</a>
          <a href="#output">Output</a>
        </nav>
        <a class="pill nav-cta gloss-btn" href="https://github.com/qyinm/etyma" target="_blank" rel="noopener">
          <img src={assetPath('github.webp')} alt="" class="github-icon" />
          View GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="reading-container hero-copy">
          <div class="status-line">
            <span class="status-dot"></span>
            Local document parsing for agent-ready knowledge.
          </div>
          <h1>Turn documents into agent-ready markdown.</h1>
          <p>
            Etyma imports PDFs and Word files, renders every page into images, runs your chosen AI provider, and saves linked markdown that stays inspectable on your machine.
          </p>
          <div class="hero-actions">
            <a class="gloss-btn download-hero-btn" href="https://github.com/qyinm/etyma/releases" target="_blank" rel="noopener">
              <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 384 512" class="apple-icon" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"></path></svg>
              Download for macOS
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            <a class="gloss-btn-light" href="#workflow">See workflow</a>
          </div>
          <div class="hero-meta" aria-label="Product metadata">
            <span class="tag-pill">macOS</span>
            <span class="tag-pill">local first</span>
            <span class="tag-pill">PDF / DOCX / DOC</span>
          </div>
        </div>

        <div class="container hero-product">
          <div class="desktop-frame hairline-card" aria-label="Etyma desktop preview">
            <div class="macos-drag-region"></div>
            <div class="chrome-left">
              <span class="chrome-btn-inner" aria-label="Collapse sidebar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
              </span>
            </div>
            <div class="chrome-right">
              <span class="chrome-btn-inner chrome-btn-active" aria-label="Hide details">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/></svg>
              </span>
            </div>
            <aside class="desktop-sidebar">
              <div class="sidebar-spacer"></div>
              <div class="sidebar-item active">
                <svg width="18" height="18" viewBox="0 0 256 256" fill="none"><path fill="currentColor" d="M200 152a31.84 31.84 0 0 0-19.53 6.68l-23.11-18A31.65 31.65 0 0 0 160 128c0-.74 0-1.48-.08-2.21l13.23-4.41A32 32 0 1 0 168 104c0 .74 0 1.48.08 2.21l-13.23 4.41A32 32 0 0 0 128 96a32.6 32.6 0 0 0-5.27.44L115.89 81A32 32 0 1 0 96 88a32.6 32.6 0 0 0 5.27-.44l6.84 15.4a31.92 31.92 0 0 0-8.57 39.64l-25.71 22.84a32.06 32.06 0 1 0 10.63 12l25.71-22.84a31.91 31.91 0 0 0 37.36-1.24l23.11 18A31.65 31.65 0 0 0 168 184a32 32 0 1 0 32-32m0-64a16 16 0 1 1-16 16a16 16 0 0 1 16-16M80 56a16 16 0 1 1 16 16a16 16 0 0 1-16-16M56 208a16 16 0 1 1 16-16a16 16 0 0 1-16 16m56-80a16 16 0 1 1 16 16a16 16 0 0 1-16-16m88 72a16 16 0 1 1 16-16a16 16 0 0 1-16 16" /></svg>
                <span>Knowledge</span>
              </div>
              <div class="sidebar-bottom">
                <div class="sidebar-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Settings</span>
                </div>
              </div>
            </aside>
            <div class="desktop-main">
              <div class="graph-column">
                <DemoGraph client:load selected={{ kind: "node", id: "concept-revenue" }} onSelect={() => {}} />
                <form class="graph-composer">
                  <button class="composer-attach" type="button" aria-label="Attach files">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  </button>
                  <input class="composer-input" placeholder="Ask this knowledge graph..." value="" />
                  <button class="composer-send" type="submit" aria-label="Ask" disabled>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </button>
                </form>
              </div>
              <aside class="inspector-rail">
                <div class="inspector-body">
                  <div class="inspector-placeholder">Select an item or connection to inspect its evidence.</div>
                  <div class="inspector-section">
                    <div class="inspector-tags">
                      <span class="inspector-tag">concept</span>
                      <span class="inspector-tag">72% confidence</span>
                    </div>
                    <h4 class="inspector-node-name">Q3 Revenue</h4>
                    <p class="inspector-node-desc">Board report revenue figures for Q3 extracted from financial summary table on page 3.</p>
                    <div class="inspector-aliases">
                      <span class="inspector-alias">Latest import</span>
                      <span class="inspector-alias">Q3 performance</span>
                    </div>
                  </div>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">workflow</span>
          <h2>Import first. Evidence always visible.</h2>
          <p>Etyma keeps the landing page and product surface centered on the same path: file in, page evidence, provider run, linked markdown out.</p>
        </div>
        <div class="container workflow-grid">
          {workflow.map((item) => (
            <article class="workflow-card hairline-card">
              <div class="workflow-step">{item.step}</div>
              <span class="tag-pill">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="providers" class="provider-section">
        <div class="container provider-grid">
          <div class="provider-copy">
            <span class="tag-pill">providers</span>
            <h2>Use local mode or bring your preferred AI provider.</h2>
            <p>
              Etyma treats AI settings as shared parsing infrastructure. Local operation stays visible, while hosted providers remain available when they fit the job.
            </p>
          </div>
          <div class="provider-card">
            <div class="provider-row">
              <span class="status-dot"></span>
              <span>Local Mode ready</span>
            </div>
            <div class="provider-list" aria-label="Supported AI providers">
              {providers.map((provider) => (
                <article class="provider-item">
                  <div class="provider-icon-wrap">
                    <img
                      src={assetPath(provider.icon)}
                      alt={`${provider.name} logo`}
                      class="provider-icon"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="provider-info">
                    <div class="provider-title-row">
                      <h3>{provider.name}</h3>
                      <div class="provider-badges">
                        <span>{provider.mode}</span>
                        {provider.comingSoon && <span class="coming-soon">Coming soon</span>}
                      </div>
                    </div>
                    <p>{provider.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="output" class="output-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">output</span>
          <h2>Markdown that agents can inspect.</h2>
          <p>Every result should be movable, readable, and grounded in source artifacts on disk.</p>
        </div>
        <div class="container capability-grid">
          {capabilities.map(([title, body]) => (
            <article class="capability-card">
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>Etyma</span>
        <div class="footer-links">
          <a href="https://github.com/qyinm/etyma" target="_blank" rel="noopener">GitHub</a>
          <a href="#workflow">Workflow</a>
          <a href="#output">Output</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--color-charcoal);
    font-size: 14px;
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-cta {
    flex: 0 0 auto;
  }

  .github-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .hero {
    padding: 88px 0 72px;
  }

  .hero-copy {
    text-align: center;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    color: var(--color-charcoal);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-terminal-green);
  }

  .hero h1 {
    margin: 28px auto 0;
    max-width: 720px;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 1.02;
    overflow-wrap: break-word;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px;
    line-height: 1.56;
  }

  .hero-actions,
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-product {
    margin-top: 56px;
  }

  .desktop-frame {
    display: grid;
    grid-template-columns: 256px minmax(0, 1fr);
    min-height: 520px;
    overflow: hidden;
    position: relative;
  }

  .macos-drag-region {
    position: absolute;
    inset: 0;
    height: 48px;
    z-index: 1;
    pointer-events: none;
  }

  .chrome-left {
    position: absolute;
    left: 44px;
    top: 10px;
    z-index: 5;
    pointer-events: none;
  }

  .chrome-right {
    position: absolute;
    right: 8px;
    top: 10px;
    z-index: 5;
    pointer-events: none;
  }

  .chrome-btn-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: rgba(255,255,255,0.8);
    color: var(--color-body);
    pointer-events: auto;
    backdrop-filter: blur(8px);
    transition: all 0.15s;
  }

  .chrome-btn-inner.chrome-btn-active {
    background: var(--color-ink);
    color: var(--color-canvas);
    border-color: var(--color-ink);
  }

  .desktop-sidebar {
    border-right: 1px solid var(--color-hairline);
    background: var(--color-surface-soft);
    padding: 0 12px 12px;
    display: flex;
    flex-direction: column;
  }

  .sidebar-spacer {
    height: 48px;
    flex-shrink: 0;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 36px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid transparent;
    color: var(--color-body);
    font-size: 13px;
    font-weight: 500;
    transition: all 0.15s;
  }

  .sidebar-item + .sidebar-item {
    margin-top: 2px;
  }

  .sidebar-item.active {
    border-color: var(--color-hairline-strong);
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .sidebar-bottom {
    margin-top: auto;
    padding-bottom: 6px;
    padding-top: 8px;
  }

  .desktop-main {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 28vw, 24rem);
    background: var(--color-canvas);
  }

  .graph-column {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    background: #fff;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    overflow: hidden;
  }

  .graph-composer {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(440px, calc(100% - 40px));
    height: 56px;
    padding: 0 8px 0 4px;
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    background: rgba(255,255,255,0.95);
    box-shadow: 0 18px 60px -12px rgba(15,23,42,0.12);
    backdrop-filter: blur(8px);
  }

  .composer-attach {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-hairline);
    border-radius: 9999px;
    background: var(--color-surface-soft);
    color: var(--color-body);
    flex-shrink: 0;
    cursor: default;
    transition: all 0.2s;
  }

  .composer-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0 8px;
    font-size: 14px;
    color: var(--color-ink);
    outline: none;
    font-family: inherit;
  }

  .composer-input::placeholder {
    color: var(--color-mute);
  }

  .composer-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-canvas);
    flex-shrink: 0;
    cursor: default;
    transition: all 0.2s;
  }

  .composer-send:disabled {
    opacity: 0.35;
  }

  .inspector-rail {
    border-left: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .inspector-header {
    border-bottom: 1px solid var(--color-hairline);
    padding: 42px 16px 14px;
  }

  .inspector-heading {
    font-size: 13px;
    font-weight: 600;
  }

  .inspector-desc {
    margin-top: 4px;
    font-size: 11px;
    line-height: 1.45;
    color: var(--color-body);
  }

  .inspector-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .inspector-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .inspector-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .inspector-tag {
    border-radius: var(--radius-full);
    border: 1px solid var(--color-hairline);
    padding: 3px 10px;
    font-size: 11px;
    background: var(--color-surface-soft);
  }

  .inspector-node-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .inspector-node-desc {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-body);
  }

  .inspector-aliases {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .inspector-alias {
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    padding: 3px 10px;
    font-size: 11px;
    color: var(--color-body);
  }

  .workflow-section,
  .provider-section,
  .output-section {
    padding: 88px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .section-heading {
    text-align: center;
  }

  .section-heading h2,
  .provider-copy h2 {
    margin-top: 18px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .section-heading p,
  .provider-copy p {
    margin-top: 16px;
    font-size: 16px;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .workflow-card {
    padding: 24px;
  }

  .workflow-step {
    margin-bottom: 28px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .workflow-card h3 {
    margin-top: 18px;
    font-size: 20px;
    line-height: 1.35;
  }

  .workflow-card p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.55;
  }

  .provider-section {
    background: var(--color-surface-dark);
    color: var(--color-on-dark);
  }

  .provider-section h2 {
    color: var(--color-on-dark);
  }

  .provider-section p {
    color: var(--color-on-dark-mute);
  }

  .provider-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    align-items: center;
    gap: 48px;
  }

  .provider-card {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    padding: 16px;
    background: rgba(255, 255, 255, 0.04);
  }

  .provider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-on-dark);
    font-weight: 500;
    padding: 8px 8px 16px;
  }

  .provider-list {
    display: grid;
    gap: 10px;
  }

  .provider-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    min-height: 82px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  .provider-icon-wrap {
    display: grid;
