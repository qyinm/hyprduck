---
import Layout from '../layouts/Layout.astro';
import { DemoGraph } from '../components/DemoGraph';

const baseUrl = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const workflow = [
  {
    step: '01',
    title: 'Add Docs',
    body: 'Bring in PDFs and Word files from approved local roots. Import stays file-first and does not depend on screen recording or accessibility permissions.',
    tag: 'pdf / docx / doc',
  },
  {
    step: '02',
    title: 'Connect Agent',
    body: 'Expose the local knowledge surface through MCP so agents can request context without receiving arbitrary filesystem access.',
    tag: 'mcp',
  },
  {
    step: '03',
    title: 'Ask With Citations',
    body: 'Queries return context packs grounded in source IDs, page refs, spans, and evidence IDs the agent can cite or retry against.',
    tag: 'context pack',
  },
  {
    step: '04',
    title: 'Verify Evidence',
    body: 'Use the graph and inspector to review document, source, concept, and citation relationships before reusing the answer.',
    tag: 'graph / evidence',
  },
  {
    step: '05',
    title: 'Reuse',
    body: 'Save corrected, cited local knowledge back into the workflow so future agents can reuse the same evidence trail.',
    tag: 'save-back',
  },
];

const capabilities = [
  ['Local paths stay private', 'Agent-facing output redacts local paths by default while keeping durable source handles available for recovery and retry.'],
  ['Citation-ready is explicit', 'Citation readiness is tracked separately from graph and wiki readiness, so agents know what evidence is safe to cite.'],
  ['Mutations stay narrow', 'Import, proposal, correction, commit, and save-back flows are purpose-built instead of generic filesystem tools.'],
];

const providers = [
  {
    name: 'Ollama',
    mode: 'Local',
    description: 'Run private document parsing against local models without an API key.',
    icon: 'provider-icons/ollama.webp',
  },
  {
    name: 'OpenRouter',
    mode: 'Router',
    description: 'Use one provider setting to reach multiple hosted model families.',
    icon: 'provider-icons/openrouter.webp',
  },
];
---

<Layout>
  <div class="page-shell">
    <header class="site-nav">
      <div class="container nav-inner">
        <a href="#" class="brand" aria-label="HyprDuck home">
          <img src={assetPath('favicon.svg')} alt="" class="brand-mark" />
          <span>HyprDuck</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#workflow">Workflow</a>
          <a href="#evidence">Evidence</a>
          <a href="#providers">Providers</a>
        </nav>
        <a class="pill pill-primary nav-cta gloss-dark" href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">
          <img src={assetPath('github.webp')} alt="" class="github-icon" />
          View GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="reading-container hero-copy">
          <div class="status-line">
            <span class="status-dot"></span>
            Private document evidence for agents.
          </div>
          <h1>HyprDuck turns local docs into cited agent context.</h1>
          <p>
            Import private documents, inspect the source graph, and hand agents context packs they can cite, verify, and reuse without losing the evidence trail.
          </p>
          <div class="hero-actions">
            <div class="download-group">
              <a class="pill pill-primary download-cta gloss-dark" href="https://github.com/qyinm/hyprduck/releases/latest" target="_blank" rel="noopener">
                <svg class="apple-icon" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M17.05 12.22c-.03-2.28 1.87-3.39 1.96-3.44c-1.08-1.57-2.74-1.79-3.32-1.81c-1.4-.15-2.76.84-3.47.84c-.72 0-1.81-.82-2.98-.79c-1.51.02-2.93.9-3.7 2.28c-1.6 2.77-.41 6.84 1.13 9.08c.77 1.1 1.66 2.33 2.83 2.29c1.15-.05 1.58-.73 2.96-.73c1.37 0 1.76.73 2.97.7c1.23-.02 2.01-1.1 2.74-2.21c.89-1.26 1.25-2.51 1.26-2.57c-.03-.01-2.39-.92-2.42-3.64ZM14.78 5.5c.61-.77 1.03-1.81.91-2.86c-.88.04-1.98.61-2.61 1.36c-.56.66-1.06 1.75-.92 2.78c.99.08 1.99-.51 2.62-1.28Z" />
                </svg>
                Download for macOS
              </a>
            </div>
            <a class="pill pill-secondary workflow-cta" href="#workflow">See workflow</a>
          </div>
          <div class="hero-meta" aria-label="Product metadata">
            <span class="tag-pill">macOS</span>
            <span class="tag-pill">MCP-ready</span>
            <span class="tag-pill">PDF / DOCX / DOC</span>
            <span class="tag-pill">Ollama / OpenRouter</span>
          </div>
          <ol class="hero-flow" aria-label="HyprDuck first-run workflow">
            {workflow.map((item) => (
              <li>
                <span>{item.step}</span>
                {item.title}
              </li>
            ))}
          </ol>
        </div>

        <div class="container hero-product">
          <div class="desktop-frame hairline-card" aria-label="HyprDuck desktop preview">
            <div class="macos-drag-region"></div>
            <div class="chrome-buttons">
              <span class="chrome-btn" aria-label="Toggle sidebar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
              </span>
              <span class="chrome-btn chrome-bell" aria-label="Brain health">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></svg>
                <span class="bell-badge">2</span>
              </span>
              <span class="chrome-btn chrome-btn-active" aria-label="Toggle inspector">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/></svg>
              </span>
            </div>
            <aside class="desktop-sidebar">
              <div class="sidebar-spacer"></div>
              <div class="sidebar-item active">
                <svg width="18" height="18" viewBox="0 0 256 256" fill="none"><path fill="currentColor" d="M200 152a31.84 31.84 0 0 0-19.53 6.68l-23.11-18A31.65 31.65 0 0 0 160 128c0-.74 0-1.48-.08-2.21l13.23-4.41A32 32 0 1 0 168 104c0 .74 0 1.48.08 2.21l-13.23 4.41A32 32 0 0 0 128 96a32.6 32.6 0 0 0-5.27.44L115.89 81A32 32 0 1 0 96 88a32.6 32.6 0 0 0 5.27-.44l6.84 15.4a31.92 31.92 0 0 0-8.57 39.64l-25.71 22.84a32.06 32.06 0 1 0 10.63 12l25.71-22.84a31.91 31.91 0 0 0 37.36-1.24l23.11 18A31.65 31.65 0 0 0 168 184a32 32 0 1 0 32-32m0-64a16 16 0 1 1-16 16a16 16 0 0 1 16-16M80 56a16 16 0 1 1 16 16a16 16 0 0 1-16-16M56 208a16 16 0 1 1 16-16a16 16 0 0 1-16 16m56-80a16 16 0 1 1 16 16a16 16 0 0 1-16-16m88 72a16 16 0 1 1 16-16a16 16 0 0 1-16 16" /></svg>
                <span>Knowledge</span>
              </div>
              <div class="sidebar-bottom">
                <div class="sidebar-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                  <span>Settings</span>
                </div>
              </div>
            </aside>
            <div class="desktop-main">
              <div class="graph-column">
                <DemoGraph client:load selected={{ kind: "node", id: "concept-revenue" }} onSelect={() => {}} />
                <form class="graph-composer">
                  <button class="composer-attach" type="button" aria-label="Attach files">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  </button>
                  <input class="composer-input" placeholder="Open Agent Terminal..." value="" />
                  <button class="composer-send" type="submit" aria-label="Open agent terminal">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
                  </button>
                </form>
              </div>
              <aside class="inspector-rail">
                <div class="inspector-header">
                  <h3 class="inspector-heading">Evidence inspector</h3>
                  <p class="inspector-desc">Selection detail, source provenance, and citation readiness stay visible without leaving the graph.</p>
                </div>
                <div class="inspector-body">
                  <div class="inspector-section">
                    <div class="inspector-tags">
                      <span class="inspector-tag">concept</span>
                      <span class="inspector-tag ready">citationReady</span>
                    </div>
                    <h4 class="inspector-node-name">Q3 Revenue</h4>
                    <p class="inspector-node-desc">Board report revenue figures for Q3 extracted from financial summary table on page 3.</p>
                    <div class="evidence-list" aria-label="Evidence references">
                      <div class="evidence-row">
                        <span>sourceId</span>
                        <strong>src_board_report</strong>
                      </div>
                      <div class="evidence-row">
                        <span>pageRef</span>
                        <strong>p.3 / table region</strong>
                      </div>
                      <div class="evidence-row">
                        <span>localPath</span>
                        <strong>redacted</strong>
                      </div>
                    </div>
                    <div class="inspector-aliases">
                      <span class="inspector-alias">Latest import</span>
                      <span class="inspector-alias">Evidence ID ev_042</span>
                    </div>
                  </div>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">workflow</span>
          <h2>The first run is a working evidence loop.</h2>
          <p>HyprDuck keeps the public promise narrow: add docs, connect an agent, ask with citations, verify the evidence, then reuse the result.</p>
        </div>
        <div class="container workflow-grid">
          {workflow.map((item) => (
            <article class="workflow-card hairline-card">
              <div class="workflow-step">{item.step}</div>
              <span class="tag-pill">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="evidence" class="evidence-section">
        <div class="container evidence-grid">
          <div class="evidence-copy">
            <span class="tag-pill">evidence</span>
            <h2>Context packs carry the proof, not just the prose.</h2>
            <p>
              Source IDs, page refs, parse warnings, provider route, content hashes, and evidence refs travel with the answer so agents can verify where a claim came from.
            </p>
          </div>
          <div class="evidence-artifact" aria-label="Context pack artifact preview">
            <div class="artifact-top">
              <span>context-pack.json</span>
              <strong>citationReady: true</strong>
            </div>
            <div class="artifact-lines">
              <code>"sourceId": "src_board_report"</code>
              <code>"pageRef": "page:3#table-region"</code>
              <code>"providerRoute": "ollama/local"</code>
              <code>"localPathDisclosure": "redacted"</code>
            </div>
          </div>
        </div>
      </section>

      <section id="providers" class="provider-section">
        <div class="container provider-grid">
          <div class="provider-copy">
            <span class="tag-pill">providers</span>
            <h2>Choose local by default, hosted when it fits.</h2>
            <p>
              HyprDuck treats provider choice as parsing infrastructure. Ollama works without an API key; OpenRouter covers hosted model routing when the job calls for it.
            </p>
          </div>
          <div class="provider-card">
            <div class="provider-row">
              <span class="status-dot"></span>
              <span>Local Mode ready</span>
            </div>
            <div class="provider-list" aria-label="Supported AI providers">
              {providers.map((provider) => (
                <article class="provider-item">
                  <div class="provider-icon-wrap">
                    <img
                      src={assetPath(provider.icon)}
                      alt={`${provider.name} logo`}
                      class="provider-icon"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="provider-info">
                    <div class="provider-title-row">
                      <h3>{provider.name}</h3>
                      <div class="provider-badges">
                        <span>{provider.mode}</span>
                      </div>
                    </div>
                    <p>{provider.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="output" class="output-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">security</span>
          <h2>Agent workflows stay scoped and auditable.</h2>
          <p>HyprDuck is built for private document reuse, so agent access is explicit, evidence-aware, and limited to the workflow being requested.</p>
        </div>
        <div class="container capability-grid">
          {capabilities.map(([title, body]) => (
            <article class="capability-card">
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>HyprDuck</span>
        <div class="footer-links">
          <a href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">GitHub</a>
          <a href="#workflow">Workflow</a>
          <a href="#evidence">Evidence</a>
          <a href="#output">Output</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--color-charcoal);
    font-size: 14px;
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-cta {
    flex: 0 0 auto;
  }

  .gloss-dark {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.04) 42%, rgba(0, 0, 0, 0.22)),
      #222;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.42),
      0 1px 2px rgba(0, 0, 0, 0.35),
      0 10px 28px rgba(0, 0, 0, 0.16);
  }

  .gloss-dark:hover {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.26), rgba(255, 255, 255, 0.06) 42%, rgba(0, 0, 0, 0.2)),
      #2a2a2a;
  }

  .github-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .hero {
    padding: 88px 0 72px;
  }

  .hero-copy {
    text-align: center;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    color: var(--color-charcoal);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-terminal-green);
  }

  .hero h1 {
    margin: 28px auto 0;
    max-width: 860px;
    font-size: 72px;
    line-height: 1.02;
    overflow-wrap: break-word;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px;
    line-height: 1.56;
  }

  .hero-actions,
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-actions {
    align-items: center;
  }

  .hero-actions .pill {
    height: 40px;
    min-height: 40px;
    padding: 0 18px;
    font-size: 14px;
  }

  .download-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .download-cta {
    position: relative;
    padding-left: 16px;
  }

  .workflow-cta {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background:
      radial-gradient(circle at 24% 0%, rgba(255, 255, 255, 0.98), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.58) 52%, rgba(245, 245, 245, 0.78)),
      rgba(255, 255, 255, 0.62);
    color: var(--color-ink);
    backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 -1px 0 rgba(0, 0, 0, 0.08),
      inset 0 0 0 1px rgba(255, 255, 255, 0.46),
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 12px 30px rgba(15, 23, 42, 0.11);
  }

  .workflow-cta::before {
    content: "";
    position: absolute;
    inset: 1px 8px auto;
    height: 45%;
    border-radius: var(--radius-full);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
    pointer-events: none;
  }

  .workflow-cta {
    isolation: isolate;
  }

  .workflow-cta:hover {
    background:
      radial-gradient(circle at 24% 0%, rgba(255, 255, 255, 1), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.68) 52%, rgba(248, 248, 248, 0.86)),
      rgba(255, 255, 255, 0.7);
  }

  .apple-icon {
    flex: 0 0 auto;
  }

  .hero-flow {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    max-width: 920px;
    margin: 34px auto 0;
    padding: 1px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-hairline);
    list-style: none;
    overflow: hidden;
  }

  .hero-flow li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 12px;
    background: var(--color-canvas);
    color: var(--color-charcoal);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .hero-flow li:first-child {
    border-radius: calc(var(--radius-lg) - 1px) 0 0 calc(var(--radius-lg) - 1px);
  }

  .hero-flow li:last-child {
    border-radius: 0 calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0;
  }

  .hero-flow span {
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }

  .hero-product {
    margin-top: 56px;
  }

  .desktop-frame {
    display: grid;
    grid-template-columns: 172px minmax(0, 1fr);
    min-height: 520px;
    overflow: hidden;
    position: relative;
  }

  .macos-drag-region {
    position: absolute;
    inset: 0;
    height: 32px;
    z-index: 1;
    pointer-events: none;
  }

  .chrome-buttons {
    position: absolute;
    top: 8px;
    left: 80px;
    right: 12px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .chrome-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-body);
    pointer-events: auto;
  }

  .chrome-btn-active {
    background: var(--color-ink);
    color: var(--color-canvas);
  }

  .chrome-bell {
    margin-left: auto;
    position: relative;
  }

  .bell-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    display: grid;
    place-items: center;
    min-width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-terminal-green);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    padding: 0 3px;
  }

  .desktop-sidebar {
    border-right: 1px solid var(--color-hairline);
    background: var(--color-surface-soft);
    padding: 0 10px 12px;
    display: flex;
    flex-direction: column;
  }

  .sidebar-spacer {
    height: 42px;
    flex-shrink: 0;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    color: var(--color-body);
    font-size: 13px;
    font-weight: 500;
  }

  .sidebar-item + .sidebar-item {
    margin-top: 2px;
  }

  .sidebar-item.active {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .sidebar-bottom {
    margin-top: auto;
    padding-bottom: 6px;
    padding-top: 8px;
  }

  .desktop-main {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(200px, 26vw, 260px);
