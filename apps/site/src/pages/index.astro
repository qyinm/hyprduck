---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const workflow = [
  {
    step: '01',
    title: 'Import a real document',
    body: 'Start with a PDF, DOCX, or DOC file. HyprDuck keeps the primary flow file-first, without screen recording or accessibility permission friction.',
    tag: 'pdf / docx / doc',
  },
  {
    step: '02',
    title: 'Render pages into evidence',
    body: 'Each page becomes an inspectable image snapshot before AI processing, so the markdown can keep a visible link back to the source page.',
    tag: 'page images',
  },
  {
    step: '03',
    title: 'Run the selected provider',
    body: 'Use local mode or a hosted provider depending on your privacy, speed, and cost needs. Provider settings stay shared across parsing flows.',
    tag: 'local / openai / anthropic',
  },
  {
    step: '04',
    title: 'Save agent-ready markdown',
    body: 'HyprDuck writes markdown and linked image assets under your Documents folder, ready for agents, wikis, notes, and local knowledge workflows.',
    tag: '~/Documents/HyprDuck',
  },
];

const proofLines = [
  '$ hyprduck parse ./board-report.pdf',
  'rendered 18 page images',
  'provider: local',
  'saved markdown: ~/Documents/HyprDuck/board-report.md',
];

const capabilities = [
  ['Local by default', 'Document import and page rendering happen in the desktop app before any provider call.'],
  ['Provider flexible', 'OpenRouter, OpenAI, Anthropic, and local providers can share the same parsing workflow.'],
  ['Evidence-linked output', 'Generated markdown references the page images on disk instead of hiding the source.'],
];

const providers = [
  {
    name: 'Ollama',
    mode: 'Local',
    description: 'Run private document parsing against local models without an API key.',
    icon: 'provider-icons/ollama.webp',
  },
  {
    name: 'OpenRouter',
    mode: 'Router',
    description: 'Use one provider setting to reach multiple hosted model families.',
    icon: 'provider-icons/openrouter.webp',
  },
  {
    name: 'OpenAI',
    mode: 'Hosted',
    description: 'Parse dense business documents with hosted frontier models.',
    icon: 'provider-icons/openai.webp',
  },
  {
    name: 'Anthropic',
    mode: 'Hosted',
    description: 'Use Claude for long-form document structure and careful extraction.',
    icon: 'provider-icons/anthropic.webp',
  },
];
---

<Layout>
  <div class="page-shell">
    <header class="site-nav">
      <div class="container nav-inner">
        <a href="#" class="brand" aria-label="HyprDuck home">
          <img src={assetPath('logo.png')} alt="" class="brand-mark" />
          <span>HyprDuck</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="#workflow">Workflow</a>
          <a href="#providers">Providers</a>
          <a href="#output">Output</a>
          <a href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <a class="pill pill-primary nav-cta" href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">
          View GitHub
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="reading-container hero-copy">
          <div class="status-line">
            <span class="status-dot"></span>
            Local document parsing for agent-ready knowledge.
          </div>
          <h1>Turn documents into agent-ready markdown.</h1>
          <p>
            HyprDuck imports PDFs and Word files, renders every page into images, runs your chosen AI provider, and saves linked markdown that stays inspectable on your machine.
          </p>
          <div class="hero-actions">
            <a class="pill pill-primary" href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">Download desktop</a>
            <a class="pill pill-secondary" href="#workflow">See workflow</a>
          </div>
          <div class="hero-meta" aria-label="Product metadata">
            <span class="tag-pill">macOS</span>
            <span class="tag-pill">local first</span>
            <span class="tag-pill">PDF / DOCX / DOC</span>
          </div>
        </div>

        <div class="container hero-product">
          <div class="desktop-frame hairline-card" aria-label="HyprDuck desktop preview">
            <aside class="desktop-sidebar">
              <div class="sidebar-title">HyprDuck</div>
              <div class="sidebar-item active">Import</div>
              <div class="sidebar-item">Provider</div>
              <div class="sidebar-item">Markdown</div>
              <div class="sidebar-item">Evidence</div>
            </aside>
            <section class="desktop-main">
              <div class="panel-header">
                <div>
                  <span class="panel-eyebrow">Current job</span>
                  <h2>board-report.pdf</h2>
                </div>
                <span class="path-pill">~/Documents/HyprDuck</span>
              </div>
              <div class="job-grid">
                <div class="import-panel hairline-card">
                  <div class="file-icon">PDF</div>
                  <h3>18 pages ready</h3>
                  <p>Rendered into image evidence before AI parsing.</p>
                  <div class="progress-track"><span style="width: 72%"></span></div>
                </div>
                <div class="terminal-card">
                  <div class="terminal-header">
                    <div class="traffic-lights" aria-hidden="true">
                      <span class="traffic-light red"></span>
                      <span class="traffic-light yellow"></span>
                      <span class="traffic-light green"></span>
                    </div>
                    <span>parse log</span>
                  </div>
                  <pre>{proofLines.join('\n')}</pre>
                </div>
              </div>
              <div class="markdown-panel hairline-card">
                <div class="markdown-title">Markdown preview</div>
                <pre>{`# Board Report

![Page 1](./images/page-001.png)

Revenue expansion was concentrated in the enterprise segment...

## Evidence
- page 1: summary table
- page 7: renewal cohort`}</pre>
              </div>
            </section>
          </div>
        </div>
      </section>

      <section id="workflow" class="workflow-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">workflow</span>
          <h2>Import first. Evidence always visible.</h2>
          <p>HyprDuck keeps the landing page and product surface centered on the same path: file in, page evidence, provider run, linked markdown out.</p>
        </div>
        <div class="container workflow-grid">
          {workflow.map((item) => (
            <article class="workflow-card hairline-card">
              <div class="workflow-step">{item.step}</div>
              <span class="tag-pill">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="providers" class="provider-section">
        <div class="container provider-grid">
          <div class="provider-copy">
            <span class="tag-pill">providers</span>
            <h2>Use local mode or bring your preferred AI provider.</h2>
            <p>
              HyprDuck treats AI settings as shared parsing infrastructure. Local operation stays visible, while hosted providers remain available when they fit the job.
            </p>
          </div>
          <div class="provider-card">
            <div class="provider-row">
              <span class="status-dot"></span>
              <span>Local Mode ready</span>
            </div>
            <div class="provider-list" aria-label="Supported AI providers">
              {providers.map((provider) => (
                <article class="provider-item">
                  <div class="provider-icon-wrap">
                    <img
                      src={assetPath(provider.icon)}
                      alt={`${provider.name} logo`}
                      class="provider-icon"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="provider-info">
                    <div class="provider-title-row">
                      <h3>{provider.name}</h3>
                      <span>{provider.mode}</span>
                    </div>
                    <p>{provider.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="output" class="output-section">
        <div class="reading-container section-heading">
          <span class="tag-pill">output</span>
          <h2>Markdown that agents can inspect.</h2>
          <p>Every result should be movable, readable, and grounded in source artifacts on disk.</p>
        </div>
        <div class="container capability-grid">
          {capabilities.map(([title, body]) => (
            <article class="capability-card">
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>HyprDuck</span>
        <div class="footer-links">
          <a href="https://github.com/qyinm/hyprduck" target="_blank" rel="noopener">GitHub</a>
          <a href="#workflow">Workflow</a>
          <a href="#output">Output</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .brand-mark {
    width: 28px;
    height: 28px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--color-charcoal);
    font-size: 14px;
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-cta {
    flex: 0 0 auto;
  }

  .hero {
    padding: 88px 0 72px;
  }

  .hero-copy {
    text-align: center;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    min-height: 36px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    color: var(--color-charcoal);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    overflow-wrap: anywhere;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-terminal-green);
  }

  .hero h1 {
    margin: 28px auto 0;
    max-width: 720px;
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 1.02;
    overflow-wrap: break-word;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px;
    line-height: 1.56;
  }

  .hero-actions,
  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-product {
    margin-top: 56px;
  }

  .desktop-frame {
    display: grid;
    grid-template-columns: 196px minmax(0, 1fr);
    min-height: 560px;
    overflow: hidden;
  }

  .desktop-sidebar {
    border-right: 1px solid var(--color-hairline);
    background: var(--color-surface-soft);
    padding: 20px;
  }

  .sidebar-title {
    margin-bottom: 22px;
    font-size: 13px;
    font-weight: 600;
  }

  .sidebar-item {
    padding: 9px 12px;
    border-radius: var(--radius-full);
    color: var(--color-body);
    font-size: 14px;
  }

  .sidebar-item + .sidebar-item {
    margin-top: 6px;
  }

  .sidebar-item.active {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .desktop-main {
    min-width: 0;
    padding: 28px;
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .panel-eyebrow,
  .markdown-title,
  .terminal-header {
    color: var(--color-body);
    font-size: 12px;
    font-weight: 500;
  }

  .panel-header h2 {
    margin-top: 4px;
    font-size: 24px;
    line-height: 1.3;
  }

  .job-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 16px;
  }

  .import-panel {
    min-width: 0;
    padding: 20px;
  }

  .file-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 64px;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background: var(--color-surface-soft);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .import-panel h3 {
    margin-top: 20px;
    font-size: 20px;
  }

  .import-panel p {
    margin-top: 8px;
    font-size: 14px;
  }

  .progress-track {
    height: 8px;
    margin-top: 28px;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
  }

  .progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-ink);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .terminal-card pre,
  .markdown-panel pre {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-charcoal);
  }

  .terminal-card pre {
    padding: 18px 16px;
  }

  .markdown-panel {
    margin-top: 16px;
    padding: 18px;
    background: var(--color-surface-soft);
  }

  .markdown-panel pre {
    margin-top: 12px;
    color: var(--color-ink);
  }

  .workflow-section,
  .provider-section,
  .output-section {
    padding: 88px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .section-heading {
    text-align: center;
  }

  .section-heading h2,
  .provider-copy h2 {
    margin-top: 18px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.12;
  }

  .section-heading p,
  .provider-copy p {
    margin-top: 16px;
    font-size: 16px;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .workflow-card {
    padding: 24px;
  }

  .workflow-step {
    margin-bottom: 28px;
    color: var(--color-mute);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .workflow-card h3 {
    margin-top: 18px;
    font-size: 20px;
    line-height: 1.35;
  }

  .workflow-card p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.55;
  }

  .provider-section {
    background: var(--color-surface-dark);
    color: var(--color-on-dark);
  }

  .provider-section h2 {
    color: var(--color-on-dark);
  }

  .provider-section p {
    color: var(--color-on-dark-mute);
  }

  .provider-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    align-items: center;
    gap: 48px;
  }

  .provider-card {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    padding: 16px;
    background: rgba(255, 255, 255, 0.04);
  }

  .provider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-on-dark);
    font-weight: 500;
    padding: 8px 8px 16px;
  }

  .provider-list {
    display: grid;
    gap: 10px;
  }

  .provider-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    min-height: 82px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.06);
  }

  .provider-icon-wrap {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: var(--color-on-dark);
  }

  .provider-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .provider-info {
    min-width: 0;
  }

  .provider-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .provider-title-row h3 {
    color: var(--color-on-dark);
    font-size: 15px;
    line-height: 1.3;
  }

  .provider-title-row span {
    flex: 0 0 auto;
    border-radius: var(--radius-full);
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-on-dark-mute);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .provider-info p {
    margin-top: 5px;
    font-size: 13px;
    line-height: 1.45;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .capability-card {
    border-top: 1px solid var(--color-hairline);
    padding-top: 18px;
  }

  .capability-card h3 {
    font-size: 20px;
  }

  .capability-card p {
    margin-top: 10px;
    font-size: 14px;
  }

  .site-footer {
    border-top: 1px solid var(--color-hairline);
    padding: 32px 0;
    color: var(--color-body);
    font-size: 12px;
  }

  .footer-inner,
  .footer-links {
    display: flex;
    align-items: center;
  }

  .footer-inner {
    justify-content: space-between;
    gap: 16px;
  }

  .footer-links {
    gap: 18px;
  }

  @media (max-width: 960px) {
    .desktop-frame,
    .provider-grid {
      grid-template-columns: 1fr;
    }

    .desktop-sidebar {
      display: none;
    }

    .workflow-grid,
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .nav-links,
    .nav-cta {
      display: none;
    }

    .hero {
      padding-top: 64px;
    }

    .hero h1 {
      max-width: 280px;
      font-size: 30px;
      line-height: 1.08;
    }

    .status-line {
      width: min(100%, 280px);
      justify-content: flex-start;
      font-size: 13px;
      line-height: 1.35;
      white-space: normal;
    }

    .hero-copy > p {
      max-width: 280px;
      font-size: 16px;
      line-height: 1.55;
    }

    .hero-actions,
    .hero-meta {
      max-width: 300px;
      margin-right: auto;
      margin-left: auto;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .pill {
      width: min(100%, 220px);
    }

    .desktop-main {
      padding: 18px;
    }

    .panel-header,
    .job-grid {
      grid-template-columns: 1fr;
    }

    .panel-header {
      display: grid;
    }

    .workflow-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
