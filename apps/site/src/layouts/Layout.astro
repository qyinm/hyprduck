---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Etyma — Local document parsing for agent-ready knowledge.", 
  description = "Etyma parses PDFs and Word files into agent-ready markdown packages using AI on macOS." 
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const assetPath = (path: string) => `${baseUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink)] overflow-x-hidden">
    <slot />
  </body>
</html>
