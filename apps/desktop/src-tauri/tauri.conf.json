{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckDocs",
  "version": "0.1.0",
  "identifier": "com.duckdocs.desktop",
  "build": {
    "beforeDevCommand": "pnpm run tauri:dev-server",
    "beforeBuildCommand": "pnpm run tauri:build-assets",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "DuckDocs",
        "width": 1160,
        "height": 860,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": ["binaries/duckdocs-engine"]
  }
}
