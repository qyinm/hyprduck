{
  "name": "duckdocs-desktop",
  "packageManager": "bun@1.2.18",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "bun run sync:engine:debug && node scripts/dev-electron.cjs",
    "build": "bun run frontend:build && bun run sync:engine:release && electron-builder --mac dir",
    "electron:dev": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "frontend:dev": "vite",
    "frontend:typecheck": "tsc --noEmit",
    "frontend:build": "tsc --noEmit && vite build",
    "test:ia": "bun test tests/ia-ui.test.mjs",
    "sync:engine:debug": "../../scripts/sync-electron-engine.sh debug",
    "sync:engine:release": "../../scripts/sync-electron-engine.sh release"
  },
  "build": {
    "appId": "com.duckdocs.desktop",
    "productName": "HyprDuck",
    "directories": {
      "output": "release/electron"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.icns",
      "identity": null
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries",
        "to": "binaries"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  }
}
