{
  "name": "duckdocs-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "frontend:dev": "vite",
    "frontend:typecheck": "tsc --noEmit",
    "frontend:build": "tsc --noEmit && vite build",
    "tauri:dev-server": "pnpm run sync:sidecar:debug && vite",
    "tauri:build-assets": "pnpm run frontend:build && pnpm run sync:sidecar:release",
    "sync:sidecar:debug": "../../scripts/sync-tauri-sidecar.sh debug",
    "sync:sidecar:release": "../../scripts/sync-tauri-sidecar.sh release"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  }
}
