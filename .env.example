# Postgres DSN (matches docker-compose.yml defaults)
ETYMA_DATABASE_URL=postgres://etyma:etyma@127.0.0.1:5432/etyma

# When 1/true/yes: require ETYMA_DATABASE_URL (fail-fast if missing)
ETYMA_CLOUD_MODE=0

# When cloud mode is off: allow SQLite spike metadata store (default allow if unset).
# Set 0/false/no to reject SQLite when no DATABASE_URL.
ETYMA_ALLOW_SQLITE=1

# Spike / server path vars (optional)
# ETYMA_SERVER_DATA=./.etyma-server-data
# ETYMA_SERVER_DB=./.etyma-server-data/server.sqlite3
# ETYMA_BLOB_ROOT=./.etyma-server-data/blobs
# ETYMA_SERVER_BIND=127.0.0.1:8787
# ETYMA_SPIKE_ADMIN_TOKEN=dev-admin
