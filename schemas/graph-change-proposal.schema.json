{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprduck.local/schemas/graph-change-proposal.schema.json",
  "title": "Agent Graph Change Proposal",
  "description": "Typed autonomous graph mutation proposal payload for source-backed node, edge, claim, and memory updates.",
  "type": "object",
  "required": ["changeType"],
  "additionalProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/newNode" },
    { "$ref": "#/$defs/newEdge" },
    { "$ref": "#/$defs/newClaim" },
    { "$ref": "#/$defs/newMemory" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "nodeKind": {
      "type": "string",
      "enum": [
        "document",
        "person",
        "organization",
        "project",
        "task",
        "concept",
        "topic",
        "source"
      ]
    },
    "relationKind": {
      "type": "string",
      "enum": [
        "mentions",
        "supports",
        "contradicts",
        "supersedes",
        "same_as",
        "works_at",
        "founded",
        "invested_in",
        "advises",
        "attended",
        "owns",
        "responsible_for",
        "decided",
        "blocks",
        "depends_on",
        "source_of",
        "derived_from",
        "related_to"
      ]
    },
    "newNode": {
      "type": "object",
      "required": ["changeType", "node"],
      "additionalProperties": false,
      "properties": {
        "changeType": { "const": "new_node" },
        "node": {
          "type": "object",
          "required": ["label", "kind", "sourcePath", "sourceRefs", "evidenceRefs"],
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/nonEmptyString" },
            "kind": { "$ref": "#/$defs/nodeKind" },
            "sourcePath": { "$ref": "#/$defs/nonEmptyString" },
            "nodeId": { "$ref": "#/$defs/nonEmptyString" },
            "aliases": { "$ref": "#/$defs/stringArray" },
            "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "evidenceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "newEdge": {
      "type": "object",
      "required": ["changeType", "edge"],
      "additionalProperties": false,
      "properties": {
        "changeType": { "const": "new_edge" },
        "edge": {
          "type": "object",
          "required": [
            "sourceNodeId",
            "targetNodeId",
            "kind",
            "label",
            "sourcePath",
            "sourceRefs",
            "evidenceRefs"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceNodeId": { "$ref": "#/$defs/nonEmptyString" },
            "targetNodeId": { "$ref": "#/$defs/nonEmptyString" },
            "kind": { "$ref": "#/$defs/relationKind" },
            "label": { "$ref": "#/$defs/nonEmptyString" },
            "sourcePath": { "$ref": "#/$defs/nonEmptyString" },
            "edgeId": { "$ref": "#/$defs/nonEmptyString" },
            "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "evidenceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "newClaim": {
      "type": "object",
      "required": ["changeType", "claim"],
      "additionalProperties": false,
      "properties": {
        "changeType": { "const": "new_claim" },
        "claim": {
          "type": "object",
          "required": ["statement", "sourcePath", "topicRefs", "sourceRefs", "evidenceRefs"],
          "additionalProperties": false,
          "properties": {
            "statement": { "$ref": "#/$defs/nonEmptyString" },
            "sourcePath": { "$ref": "#/$defs/nonEmptyString" },
            "claimId": { "$ref": "#/$defs/nonEmptyString" },
            "topicRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "evidenceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "newMemory": {
      "type": "object",
      "required": ["changeType", "memory"],
      "additionalProperties": false,
      "properties": {
        "changeType": { "const": "new_memory" },
        "memory": {
          "type": "object",
          "required": ["title", "body", "sourcePath", "sourceRefs", "evidenceRefs"],
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/nonEmptyString" },
            "body": { "$ref": "#/$defs/nonEmptyString" },
            "sourcePath": { "$ref": "#/$defs/nonEmptyString" },
            "memoryId": { "$ref": "#/$defs/nonEmptyString" },
            "sourceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "evidenceRefs": { "$ref": "#/$defs/stringArray", "minItems": 1 },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    }
  }
}
