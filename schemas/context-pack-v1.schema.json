{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etyma.local/schemas/context-pack-v1.schema.json",
  "title": "Etyma Context Pack v1",
  "description": "Stable external agent-facing contract for query-time cited local context packs with typed evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "workspaceId",
    "query",
    "generatedAt",
    "sourceSet",
    "selectedEvidence",
    "findings",
    "warnings",
    "retrievalTrace",
    "suggestedNextReads"
  ],
  "properties": {
    "schemaVersion": {
      "const": "etyma.context_pack.v1"
    },
    "packId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "workspaceId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "query": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "selectedEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "retrievalTrace": {
      "$ref": "#/$defs/retrievalTrace"
    },
    "suggestedNextReads": {
      "type": "array",
      "items": { "$ref": "#/$defs/suggestedNextRead" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableNonEmptyString": {
      "anyOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "text",
        "table",
        "image_region",
        "ocr",
        "caption",
        "summary",
        "claim",
        "relationship",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "originalFilename",
        "contentHash",
        "pageCount",
        "ingestionStatus",
        "staleness",
        "providerRoute",
        "localOnly"
      ],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "originalFilename": { "$ref": "#/$defs/nonEmptyString" },
        "contentHash": { "$ref": "#/$defs/nonEmptyString" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "ingestionStatus": { "$ref": "#/$defs/nonEmptyString" },
        "staleness": {
          "enum": ["current", "stale", "unknown"]
        },
        "providerRoute": { "$ref": "#/$defs/nonEmptyString" },
        "localOnly": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRef",
        "sourceId",
        "page",
        "region",
        "span",
        "quotedText",
        "parseConfidence",
        "selectionReason",
        "contentHash",
        "evidenceType"
      ],
      "properties": {
        "evidenceRef": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/nullableNonEmptyString" },
        "span": { "$ref": "#/$defs/nullableNonEmptyString" },
        "quotedText": { "$ref": "#/$defs/nonEmptyString" },
        "parseConfidence": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "selectionReason": { "$ref": "#/$defs/nonEmptyString" },
        "contentHash": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceType": { "$ref": "#/$defs/evidenceType" },
        "graphTrail": { "$ref": "#/$defs/graphTrail" }
      },
      "anyOf": [
        {
          "properties": {
            "region": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "properties": {
            "span": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "statement",
        "status",
        "statementConfidence",
        "derivedFrom",
        "relevanceReason"
      ],
      "properties": {
        "findingId": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "const": "derived_summary"
        },
        "statementConfidence": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "derivedFrom": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "minItems": 1,
          "uniqueItems": true
        },
        "relevanceReason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "pageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "page"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "page": { "type": "integer", "minimum": 1 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "message", "pageRefs"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "severity": {
          "enum": ["low", "medium", "high"]
        },
        "message": { "$ref": "#/$defs/nonEmptyString" },
        "pageRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/pageRef" }
        }
      }
    },
    "retrievalTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "chunksConsidered",
        "chunksSelected",
        "budgetRequested",
        "budgetUsed",
        "evidenceTypeTrace"
      ],
      "properties": {
        "strategy": { "$ref": "#/$defs/nonEmptyString" },
        "chunksConsidered": { "type": "integer", "minimum": 0 },
        "chunksSelected": { "type": "integer", "minimum": 0 },
        "budgetRequested": { "type": "integer", "minimum": 0 },
        "budgetUsed": { "type": "integer", "minimum": 0 },
        "evidenceTypeTrace": {
          "type": "object",
          "required": ["considered", "selected"],
          "properties": {
            "considered": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "selected": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "suggestedNextRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "page", "reason"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "page": { "type": "integer", "minimum": 1 },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "safeWikiPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^wiki/(?!~\\/)(?![A-Za-z]:\\/)(?!\\/)(?!.*\\/\\/)(?!.*~\\/)(?!.*[A-Za-z]:\\/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\.\\./)(?!.*[dD][oO][cC][sS]/[pP][rR][iI][vV][aA][tT][eE])(?!.*%2[eEfF])(?!.*%5[cC])(?!.*\\\\).+\\S.*$"
    },
    "graphRecordType": {
      "type": "string",
      "enum": ["node", "relation", "claim", "wiki_page", "source", "evidence"]
    },
    "graphRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "reason"],
      "properties": {
        "type": { "$ref": "#/$defs/graphRecordType" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "readNodeArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "readSourceArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "readPageEvidenceArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "page"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "page": { "type": "integer", "minimum": 1 }
      }
    },
    "readWikiPageArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/safeWikiPath" }
      }
    },
    "graphFollowUp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "handleType", "arguments", "reason"],
          "properties": {
            "tool": { "const": "read_node" },
            "handleType": { "const": "node" },
            "arguments": { "$ref": "#/$defs/readNodeArguments" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "handleType", "arguments", "reason"],
          "properties": {
            "tool": { "const": "read_source" },
            "handleType": { "const": "source" },
            "arguments": { "$ref": "#/$defs/readSourceArguments" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "handleType", "arguments", "reason"],
          "properties": {
            "tool": { "const": "read_page_evidence" },
            "handleType": { "const": "page_evidence" },
            "arguments": { "$ref": "#/$defs/readPageEvidenceArguments" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "handleType", "arguments", "reason"],
          "properties": {
            "tool": { "const": "read_wiki_page" },
            "handleType": { "const": "wiki_page" },
            "arguments": { "$ref": "#/$defs/readWikiPageArguments" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "graphTrail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphRecord" }
        },
        "adjacent": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphRecord" }
        },
        "followUp": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphFollowUp" }
        },
        "unavailableReason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
